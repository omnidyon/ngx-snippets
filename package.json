{
  "name": "@omnidyon/ngx-snippets",
  "version": "1.0.18",
  "description": "An Angular library for adding code snippets top you application. It's easy to use, flexible and lightweight.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve examples",
    "build": "ng build ngx-snippets",
    "watch": "ng build ngx-snippets --watch",
    "test": "ng test --source-map=false",
    "publish:lib": "npm run build && npm publish dist/ngx-snippets && npx jsr publish"
  },
  "private": false,
